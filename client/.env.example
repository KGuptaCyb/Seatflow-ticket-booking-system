# Values with a VITE_ prefix are public browser configuration. Leaving API and
# socket URLs unset uses Vite's same-origin development proxy, which also works
# from a LAN phone. Production should set the deployed public URLs explicitly.
# VITE_API_URL="https://api.example.com/api"
# VITE_SOCKET_URL="https://api.example.com"
# VITE_API_PROXY_TARGET="http://localhost:4000"
# VITE_SOCKET_PROXY_TARGET="http://localhost:4000"
