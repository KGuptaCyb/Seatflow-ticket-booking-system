{
  "name": "seatflow-ticketing", "private": true, "workspaces": ["server", "client"],
  "scripts": { "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"", "build": "npm run build -w server && npm run build -w client", "test": "npm run test -w server", "test:services:up": "docker compose -f compose.integration.yml up -d", "test:services:down": "docker compose -f compose.integration.yml down" },
  "devDependencies": { "concurrently": "^9.1.0" }
}
