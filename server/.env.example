DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seatflow"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-at-least-32-random-characters"
# Comma-separated exact browser origins permitted by CORS. In production set
# only your deployed frontend origin and NODE_ENV=production.
CLIENT_URL="http://localhost:5173"
# Development-only exact origins, useful when CLIENT_URL points at a LAN URL.
DEV_CLIENT_URLS="http://localhost:5173"
NODE_ENV="development"
# Browser origin encoded into QR tickets. For LAN testing set both of these
# URL values to your computer's LAN address; never use localhost on a phone.
PUBLIC_FRONTEND_URL="http://localhost:5173"
HOST="0.0.0.0"
PORT=4000
SEAT_HOLD_TTL_MINUTES=10
# Payment QR capability lifetime. It is also capped by the seat hold expiry.
PAYMENT_ACTION_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=10
RESEND_API_KEY=
EMAIL_FROM="tickets@example.com"
